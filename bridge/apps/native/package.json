{
  "name": "@tuya-bridge/native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cmake -B build -S . && cmake --build build -j4 && cp build/compile_commands.json . 2>/dev/null || true",
    "test": "cd build && ./tuya-reassembler-test",
    "clean": "rm -rf build",
    "format": "find src tests -type f \\( -name \"*.cpp\" -o -name \"*.hpp\" \\) -exec clang-format -i {} +",
    "format:check": "find src tests -type f \\( -name \"*.cpp\" -o -name \"*.hpp\" \\) -exec clang-format --dry-run --Werror {} +",
    "dev": "true"
  }
}
